{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/indexer/Dockerfile",
    "watchPatterns": [
      "/apps/indexer/**",
      "/packages/**",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/package.json"
    ]
  },
  "deploy": {
    "startCommand": "node --import tsx src/ledger-tip-service.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
