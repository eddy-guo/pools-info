# Copy to .env.local at the repository root. Never commit the real values.
# Frontend preload needs no key. Persistent analytics requires archival RPC state.

# Optional alternate Robinhood Chain RPC. The collector defaults to public RPC.
# ROBINHOOD_RPC_URL=https://your-provider
# ENS resolution reads Ethereum, not Robinhood. No key needed by default.
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Persistent indexer. Local development uses a separate local Postgres database.
# Railway worker uses DATABASE_URL=${{Postgres.DATABASE_URL}} privately.
# DATABASE_URL=postgresql://user:password@host:port/database
# Keep production Postgres private. Never expose credentials via NEXT_PUBLIC_*.
# Required initial discovery boundary. 62625935 is the verified PEPE launch
# for a small first rollout; this does not include earlier Pools launches.
# INDEXER_START_BLOCK=62625935
# INDEXER_BATCH_BLOCKS=1000
# Leave the log override unset to use ROBINHOOD_RPC_URL for logs and state.
# Railway may reference the same credential as ${{indexer.ROBINHOOD_RPC_URL}}.
# The public Robinhood log endpoint returned HTTP 403 from Railway.
# INDEXER_LOG_RPC_URL=https://your-verified-log-provider
# INDEXER_LOG_RANGE_BLOCKS=10
# Optional verified initial capture, skipped after an equal/newer publication exists.
# ANALYTICS_SEED_PATH=/app/data/analytics/pepe-capture.json.gz
# INDEXER_POLL_MS=15000
# INDEXER_POOLS_PER_CYCLE=2
# 0 pauses the tier-3 per-pool sweeps and keeps their saved cursors; discovery,
# the broad range, the live feed and analytics keep running. `indexer:status`
# reports the value in effect. Default 1 (unchanged behavior).
# INDEXER_DEEP_TIER_ENABLED=1
# Live feed pause after a cycle that reached the confirmed head (ms). Each
# cycle pays fixed reads (head, cursors, both boundaries, one log query).
# RECENT_TIP_POLL_MS=30000
# Where the live feed reads the chain (docs/HYPERSYNC-TIP.md). rpc (default) is
# the JSON-RPC provider; hypersync reads logs, transactions and headers from
# Envio HyperSync with ENVIO_API_TOKEN and HYPERSYNC_URL below, and reads
# JSON-RPC only for a new launch's name and symbol. HyperSync paces at one
# request per 2 s (30 per minute) or slower; RECENT_BATCH_BLOCKS then defaults
# to 2000.
# RECENT_SOURCE=rpc
# RECENT_HYPERSYNC_MIN_INTERVAL_MS=2000
# RECENT_HYPERSYNC_MAX_PAGES=4
# Multicall3 aggregates name/symbol, decimals/totalSupply and balanceOf reads
# into one eth_call per bounded batch. Unset selects the canonical deployment
# 0xcA11bde05977b3631167028862bE2a173976CA11 (verified on chain 4663);
# 0 disables aggregation; another value must be a deployed Multicall3.
# MULTICALL3_ADDRESS=
# How many blocks a saved sender code observation may answer for before a
# fresh eth_getCode is required (see migration 013). 0 never reuses.
# SENDER_CODE_RECHECK_BLOCKS=1000000
# Tests only; must point to a separate test database, never production.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/pools_test

# Read API token icon store (apps/api/README.md, "Token icon store"). Optional;
# defaults are 10000 ms, 8 fetches, 300 s doubling up to 86400 s (3600 s for a
# bare deadline expiry), and a 12000 ms per-request cap.
# TOKEN_IMAGE_DEADLINE_MS=
# TOKEN_IMAGE_CONCURRENCY=
# TOKEN_IMAGE_RETRY_SECONDS=
# TOKEN_IMAGE_REJECTED_SECONDS=
# TOKEN_IMAGE_REQUEST_CAP_MS=
# TOKEN_IMAGE_TIMEOUT_REJECTED_SECONDS=

# Read API only: where explore's and the pool page's market figures come from
# (docs/LEDGER-MARKET-SERVING.md). Unset or broad serves the broad rollups and
# deep publications; ledger serves every pool the aggregate ledger covers from
# its pool hours and state. Read once at startup; any other value refuses to
# start.
# MARKET_SOURCE=broad

# Read API only: free Blockscout PRO key for on-demand wallet history pages
# (/v1/wallets/:address/history). Server-side only; without it that one route
# answers 503 not_configured. See apps/api/README.md for the cap/TTL variables.
# BLOCKSCOUT_API_KEY=

# Optional Railway read API origin. Server-only: the browser still calls Next.
# Set after the read service is deployed and required pool coverage is verified.
# INDEXER_API_URL=https://your-read-api.up.railway.app

# CLI-only scan settings:
# CHAIN_BLOCK_SPAN=100000
# CHAIN_POOL_LIMIT=8
# CHAIN_INCLUDE_ACCOUNTING=1

# Disable runtime provider requests, e.g. for a wholly offline preview.
# CHAIN_REFRESH_DISABLED=1

# Serve the committed dataset under data/ as this deployment's own source. The
# browser suites set it; production never does. Without it a read the read API
# cannot answer is reported unavailable, and no stored figure stands in for it.
# PRODUCT_FIXTURES=1

# Final public origin for social metadata. Vercel's production URL is the default.
# SITE_URL=https://poolsinfo.com

# Shared settings used independently by each Railway indexer child process.
# Defaults preserve current pacing. These are not an account-wide rate limiter.
# Only increase throughput after verifying provider capacity across all workers.
# RPC_MIN_INTERVAL_MS=1000
# RPC_MAX_BATCH_SIZE=2

# Envio HyperSync: the live feed with RECENT_SOURCE=hypersync (docs/HYPERSYNC-TIP.md)
# and the tier-2 swap history backfill (docs/HYPERSYNC-BACKFILL.md).
# Manual and bounded: `pnpm hypersync:plan` reads one page and writes nothing;
# `pnpm hypersync:run` commits bounded broad batches. Both refuse unless the
# enable flag and the token are set. The indexer service never starts it.
# ENVIO_API_TOKEN=your-envio-api-token
# HYPERSYNC_URL=https://4663.hypersync.xyz
# HYPERSYNC_BACKFILL_ENABLED=1
# HYPERSYNC_BATCH_BLOCKS=9999
# HYPERSYNC_MAX_PAGES=4
# HYPERSYNC_MAX_BATCHES=50
# HYPERSYNC_MAX_BLOCKS=500000
# HYPERSYNC_MAX_REQUESTS=2000
# HYPERSYNC_MIN_INTERVAL_MS=1000

# The aggregate ledger's one-time history pass (docs/AGGREGATE-LEDGER.md,
# phase 2): `pnpm ledger:pass run` folds the whole registered history from
# HyperSync into the agg_* tables, resumable from its cursor; `status` reads
# the streams and `calibrate <from> <to>` collects one range and writes
# nothing. Manual, off by default, never started by the indexer service; it
# refuses unless the enable flag and ENVIO_API_TOKEN are set. Name, symbol
# and decimals are read through Multicall3 over ROBINHOOD_RPC_URL, which must
# be the public RPC (an Alchemy host is refused). The pacing floor is 2,000 ms
# (30 requests per minute, the free tier's sustained rate); quiet ranges grow
# from LEDGER_PASS_RANGE_BLOCKS up to LEDGER_PASS_MAX_RANGE_BLOCKS.
# LEDGER_PASS_ENABLED=1
# LEDGER_PASS_RANGE_BLOCKS=100000
# LEDGER_PASS_MAX_RANGE_BLOCKS=1000000
# LEDGER_PASS_MIN_INTERVAL_MS=2000
# LEDGER_PASS_MAX_PAGES=16
# LEDGER_PASS_MAX_REQUESTS=100000
# LEDGER_PASS_MAX_RANGES=

# The aggregate ledger's tip loop (docs/AGGREGATE-LEDGER.md, phase 3):
# `pnpm ledger:tip run` keeps the ledger the pass built current from HyperSync
# (the launch lane with name, symbol, decimals and total supply, the swaps and
# transfers, the 24-hour live ring and the leaderboard windows); `once` runs
# one cycle and `status` reads the tables. Railway runs it as its own service
# (apps/indexer/railway.ledger-tip.json, `src/ledger-tip-service.ts`), never
# through the indexer service, whose workers read Alchemy. It refuses a
# database that holds no ledger before migrating it, and refuses unless the
# enable flag and ENVIO_API_TOKEN are set; ROBINHOOD_RPC_URL must be the public
# RPC. HyperSync paces at one request per 2 s or slower; a tip cycle is about
# ten requests, followed by LEDGER_TIP_POLL_MS at the confirmed tip.
# LEDGER_TIP_ENABLED=1
# LEDGER_TIP_POLL_MS=60000
# LEDGER_TIP_RANGE_BLOCKS=2000
# LEDGER_TIP_MAX_RANGE_BLOCKS=100000
# LEDGER_TIP_MIN_INTERVAL_MS=2000
# LEDGER_TIP_MAX_PAGES=16
# LEDGER_TIP_WINDOW_REFRESH_MS=60000
