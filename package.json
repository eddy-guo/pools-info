{
  "name": "pools-info",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --run dev:web",
    "dev:web": "pnpm --filter @pools/web dev",
    "build": "pnpm --filter @pools/web build",
    "preview": "node --env-file-if-exists=.env.local --run preview:web",
    "preview:web": "pnpm --filter @pools/web start --hostname 127.0.0.1 --port 3100",
    "lint": "pnpm --filter @pools/web lint",
    "typecheck": "pnpm --filter @pools/core typecheck && pnpm --filter @pools/web typecheck && tsc -p scripts/tsconfig.json && pnpm --filter @pools/chain typecheck",
    "test": "tsx --test packages/core/src/*.test.ts packages/chain/src/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "snapshot:chain": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot-chain.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@pools/chain": "workspace:*",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
